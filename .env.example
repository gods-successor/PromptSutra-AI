# Local setup script generates a safe random APP_SECRET automatically.
ENVIRONMENT=development
APP_SECRET=
DATABASE_URL=
SECURE_COOKIES=false

# FREE Gemini API key from https://aistudio.google.com/apikey
# Choose a model available in your account's free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Without SMTP, local development codes print in terminal (NOT delivered to Gmail).
# For actual email OTP, configure a real SMTP provider / app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional Google login (Firebase Spark plan)
# Requires Firebase project with Google provider and service account JSON.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT=
